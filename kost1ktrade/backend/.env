# --- General Bot Settings ---
# Comma-separated list of symbols to trade. Use the format recognized by the exchange (e.g., BTC/USDT).
# Note: The application internally uses '/' as the separator.
SYMBOLS_RAW=BTC/USDT,ETH/USDT,SOL/USDT,LINK/USDT
# OKX WebSocket URL for public data streams.
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public
# Maximum number of candles to fetch for analysis.
MAX_CANDLES=5000
# Default timeframe for the bots
TIMEFRAME=1h

# --- Backtest Parameters ---
BACKTEST_COMMISSION_PCT=0.001
BACKTEST_SLIPPAGE_PCT=0.0005

# --- Risk Management Settings ---
RISK__MAX_DAILY_DRAWDOWN_PCT=0.03
RISK__MAX_CONCURRENT_POSITIONS=4
RISK__RISK_PER_TRADE=0.03
RISK__MIN_RISK_PER_TRADE=0.005
RISK__VOLATILITY_RISK_ADJUSTMENT_FACTOR=1.0
RISK__MAX_DAILY_LOSS_PCT=0.05

# --- Trade Management Settings ---
TRADE__ATR_MULTIPLIER_FOR_SL=1.2
TRADE__ATR_MULTIPLIER_FOR_TP1=1.5
TRADE__ATR_MULTIPLIER_FOR_TP2=3.0
TRADE__CORRELATION_RISK_REDUCTION_FACTOR=0.7
TRADE__VOLATILITY_SPIKE_FACTOR=2.5
TRADE__CORRELATION_THRESHOLD=0.7

# --- ML Model Settings ---
ML__CONFIDENCE_THRESHOLD=0.4
ML__ATR_LABEL_THRESHOLD=0.4

# --- Indicator Settings ---

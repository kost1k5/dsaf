# .env file for kost1ktrade backend

# --- Core Bot Settings ---
SYMBOLS_RAW="BTC/USDT,ETH/USDT,SOL/USDT,LINK/USDT"
OKX_WS_URL="wss://ws.okx.com:8443/ws/v5/public"
MAX_CANDLES=26000
TIMEFRAME="1h"
COMMANDER_SYMBOL="BTC/USDT"
DATA_HISTORY_DAYS=1095

# --- Backtest Settings ---
BACKTEST_COMMISSION_PCT=0.001
BACKTEST_SLIPPAGE_PCT=0.0005

# --- API Keys (not required for this script, but good to have placeholders) ---
TELEGRAM_TOKEN="your_token_here"
TELEGRAM_CHAT_ID="your_chat_id_here"
NEWS_API_KEY="your_key_here"
GEMINI_API_KEY="your_key_here"
FRED_API_KEY="your_key_here"

# --- Risk Management Settings (RISK__) ---
RISK__MAX_DAILY_DRAWDOWN_PCT=5.0
RISK__MAX_CONCURRENT_POSITIONS=5
RISK__RISK_PER_TRADE=100.0
RISK__MIN_RISK_PER_TRADE=10.0
RISK__VOLATILITY_RISK_ADJUSTMENT_FACTOR=1.5
RISK__MAX_DAILY_LOSS_PCT=10.0
RISK__RISK_PER_TRADE_PCT=1.0
RISK__ATR_MULTIPLIER=2.0

# --- Trade Management Settings (TRADE__) ---
TRADE__ATR_MULTIPLIER_FOR_SL=2.0
TRADE__ATR_MULTIPLIER_FOR_TP1=1.5
TRADE__ATR_MULTIPLIER_FOR_TP2=3.0
TRADE__CORRELATION_RISK_REDUCTION_FACTOR=0.5
TRADE__VOLATILITY_SPIKE_FACTOR=2.5
TRADE__CORRELATION_THRESHOLD=0.8

# --- Confluence Strategy Parameters (STRATEGY__) ---
STRATEGY__EMA_FAST=12
STRATEGY__EMA_SLOW=50
STRATEGY__RSI_PERIOD=14
STRATEGY__RSI_ENTRY_LEVEL=50
STRATEGY__OBV_SMA_PERIOD=20
STRATEGY__ATR_PERIOD=14
STRATEGY__ATR_SMA_PERIOD=20
STRATEGY__ADX_PERIOD=14
STRATEGY__ADX_TREND_THRESHOLD=25
STRATEGY__RISK_SL_ATR_MULT=2.0
STRATEGY__RISK_TP_ATR_MULT=3.0

# --- ML Model Settings (ML__) ---
ML__HYBRID_CONFIDENCE_THRESHOLD=0.65
ML__CONFIDENCE_THRESHOLD=0.55
ML__ATR_LABEL_THRESHOLD=1.5
ML__MIN_TRADES_FOR_EVAL=30
ML__SHAP_THRESHOLD=0.01
ML__CORR_THRESHOLD=0.9
ML__OPTUNA_TRIALS=50
ML__MIN_TRAIN_SAMPLES=500

# --- Evaluation Settings (EVAL__) ---
EVAL__INITIAL_CAPITAL=10000.0
EVAL__RISK_PER_TRADE=100.0
EVAL__COMMISSION_RATE=0.001
EVAL__SLIPPAGE_RATE=0.0005
EVAL__TP_ATR_MULT=2.0
EVAL__SL_ATR_MULT=1.5

# --- Backtest Strategy Settings (BACKTEST_STRATEGY__) ---
BACKTEST_STRATEGY__TP_ATR_MULT=2.0
BACKTEST_STRATEGY__SL_ATR_MULT=1.5
BACKTEST_STRATEGY__CONFIDENCE_THRESHOLD=0.6
BACKTEST_STRATEGY__MAX_HOLDING_PERIOD=24
BACKTEST_STRATEGY__HIGH_CONFIDENCE_THRESHOLD=0.75
BACKTEST_STRATEGY__HIGH_RISK_PCT=2.0
BACKTEST_STRATEGY__MED_RISK_PCT=1.0
BACKTEST_STRATEGY__LOW_RISK_PCT=0.5
BACKTEST_STRATEGY__LOSS_STREAK_THRESHOLD=5
BACKTEST_STRATEGY__TRADING_PAUSE_HOURS=12

# --- Indicator Settings (INDICATORS__) ---
INDICATORS__RSI_PERIOD=14
INDICATORS__EMA_FAST_PERIOD=12
INDICATORS__EMA_SLOW_PERIOD=26
INDICATORS__BB_PERIOD=20
INDICATORS__BB_STD_DEV=2
INDICATORS__ATR_PERIOD=14
INDICATORS__ADX_PERIOD=14
INDICATORS__VWAP_PERIOD=20
INDICATORS__MACD_FAST=12
INDICATORS__MACD_SLOW=26
INDICATORS__MACD_SIGNAL=9
INDICATORS__SMA_PERIOD=20
INDICATORS__SMA_LONG_PERIOD=50
INDICATORS__STOCH_K_PERIOD=14
INDICATORS__STOCH_D_PERIOD=3
INDICATORS__AO_FAST_PERIOD=5
INDICATORS__AO_SLOW_PERIOD=34
INDICATORS__PSAR_ACCELERATION=0.02
INDICATORS__PSAR_MAXIMUM=0.2
INDICATORS__KC_LENGTH=20
INDICATORS__KC_MULTIPLIER=2.0
INDICATORS__KC_ATR_LENGTH=10
INDICATORS__IC_TENKAN=9
INDICATORS__IC_KIJUN=26
INDICATORS__IC_SENKOU_B=52

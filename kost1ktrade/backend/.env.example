# This is an example .env file.
# Copy this to a new file named .env and fill in your actual credentials.
# The .env file is ignored by git, so your secrets will not be committed.

# -----------------------------------------------------------------------------
# SECTION 1: CORE SETTINGS & API KEYS (Mandatory)
# -----------------------------------------------------------------------------

# --- General Bot Settings ---
SYMBOLS_RAW="BTC/USDT,ETH/USDT,SOL/USDT,LINK/USDT"
TIMEFRAME="1h"
COMMANDER_SYMBOL="BTC-USDT-SWAP"
DATA_HISTORY_DAYS=1095
# Set to cover 3 years of hourly data (3 * 365 * 24 = 26280)
MAX_CANDLES=30000
OKX_WS_URL="wss://ws.okx.com:8443/ws/v5/public"

# --- API Keys (Secrets) ---
# OKX REAL ACCOUNT API Credentials
OKX_REAL__API_KEY=your_real_api_key_here
OKX_REAL__SECRET_KEY=your_real_secret_key_here
OKX_REAL__PASSPHRASE=your_real_passphrase_here

# OKX DEMO ACCOUNT API Credentials
OKX_DEMO__API_KEY=your_demo_api_key_here
OKX_DEMO__SECRET_KEY=your_demo_secret_key_here
OKX_DEMO__PASSPHRASE=your_demo_passphrase_here

# Telegram Notifications
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Other Service APIs
NEWS_API_KEY=your_newsapi_org_key
GEMINI_API_KEY=your_google_gemini_api_key
FRED_API_KEY=your_fred_api_key_here # Get from https://fred.stlouisfed.org/docs/api/api_key.html

# -----------------------------------------------------------------------------
# SECTION 2: TRADING & RISK PARAMETERS
# -----------------------------------------------------------------------------

# --- Backtest Simulation Settings ---
# Unified realistic commission (0.05% taker fee on OKX)
BACKTEST_COMMISSION_PCT=0.0005
BACKTEST_SLIPPAGE_PCT=0.0005

# --- Evaluation Settings (EVAL__) ---
# These parameters are used in the `evaluate_model.py` script for a simplified backtest
# to find the optimal probability thresholds.
EVAL__INITIAL_CAPITAL=10000.0
EVAL__RISK_PER_TRADE=0.01
EVAL__COMMISSION_RATE=0.0005
EVAL__SLIPPAGE_RATE=0.0005
EVAL__TP_ATR_MULT=2.0
EVAL__SL_ATR_MULT=1.5

# --- Risk Management Settings (RISK__) ---
# These settings are prefixed with 'RISK__'
RISK__MAX_DAILY_DRAWDOWN_PCT=0.05
RISK__MAX_CONCURRENT_POSITIONS=4
# Default risk per trade set to a more conservative 1.5%
RISK__RISK_PER_TRADE=0.015
RISK__MIN_RISK_PER_TRADE=0.005
RISK__VOLATILITY_RISK_ADJUSTMENT_FACTOR=1.0
RISK__MAX_DAILY_LOSS_PCT=0.05
RISK__ATR_MULTIPLIER=2.0

# --- Trade Management Settings (TRADE__) ---
# These settings are prefixed with 'TRADE__'
# Adjusted for a better Risk/Reward Ratio (e.g., 2.0/1.5 = 1.33 RRR)
TRADE__ATR_MULTIPLIER_FOR_SL=1.5
TRADE__ATR_MULTIPLIER_FOR_TP1=2.0
TRADE__ATR_MULTIPLIER_FOR_TP2=3.0
TRADE__CORRELATION_RISK_REDUCTION_FACTOR=0.7
TRADE__VOLATILITY_SPIKE_FACTOR=2.5
TRADE__CORRELATION_THRESHOLD=0.7

# -----------------------------------------------------------------------------
# SECTION 3: ML & INDICATOR PARAMETERS
# -----------------------------------------------------------------------------

# --- ML Model Settings (ML__) ---
# Unified threshold with backtest settings for consistency
ML__CONFIDENCE_THRESHOLD=0.6
ML__ATR_LABEL_THRESHOLD=0.4
ML__MIN_TRADES_FOR_EVAL=1000
ML__SHAP_THRESHOLD=0.01
ML__CORR_THRESHOLD=0.75
# Increased trials for better hyperparameter optimization
ML__OPTUNA_TRIALS=100
# Increased minimum samples to prevent overfitting
ML__MIN_TRAIN_SAMPLES=1000

# --- Backtest Strategy Settings (BACKTEST_STRATEGY__) ---
# Parameters for the detailed backtest simulation in `run_backtest.py`
BACKTEST_STRATEGY__TP_ATR_MULT=2.0
BACKTEST_STRATEGY__SL_ATR_MULT=1.5
BACKTEST_STRATEGY__CONFIDENCE_THRESHOLD=0.6
BACKTEST_STRATEGY__MAX_HOLDING_PERIOD=24
BACKTEST_STRATEGY__HIGH_CONFIDENCE_THRESHOLD=0.8
BACKTEST_STRATEGY__HIGH_RISK_PCT=0.02
BACKTEST_STRATEGY__MED_RISK_PCT=0.01
BACKTEST_STRATEGY__LOW_RISK_PCT=0.005
BACKTEST_STRATEGY__LOSS_STREAK_THRESHOLD=3
BACKTEST_STRATEGY__TRADING_PAUSE_HOURS=24

# --- Indicator Settings (INDICATORS__) ---
INDICATORS__RSI_PERIOD=14
INDICATORS__EMA_FAST_PERIOD=12
INDICATORS__EMA_SLOW_PERIOD=26
INDICATORS__BB_PERIOD=20
INDICATORS__BB_STD_DEV=2
INDICATORS__ATR_PERIOD=14
INDICATORS__ADX_PERIOD=14
INDICATORS__VWAP_PERIOD=20
INDICATORS__MACD_FAST=12
INDICATORS__MACD_SLOW=26
INDICATORS__MACD_SIGNAL=9
INDICATORS__SMA_PERIOD=20
INDICATORS__SMA_LONG_PERIOD=50
INDICATORS__STOCH_K_PERIOD=14
INDICATORS__STOCH_D_PERIOD=3
INDICATORS__AO_FAST_PERIOD=5
INDICATORS__AO_SLOW_PERIOD=34
INDICATORS__PSAR_ACCELERATION=0.02
INDICATORS__PSAR_MAXIMUM=0.2
INDICATORS__KC_LENGTH=20
INDICATORS__KC_MULTIPLIER=2.0
INDICATORS__KC_ATR_LENGTH=14
INDICATORS__IC_TENKAN=9
INDICATORS__IC_KIJUN=26
INDICATORS__IC_SENKOU_B=52
